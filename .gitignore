# ═══════════════════════════════════════════════════

# Байт-код
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg

# Дистрибуция
dist/
build/
*.egg-info/
*.egg
eggs/
sdist/
develop-eggs/

# Виртуальное окружение
venv/
env/
.venv/
.env/
virtualenv/
ENV/
env.bak/
venv.bak/

# Установщики
Pipfile.lock
*.whl

