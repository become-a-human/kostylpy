# MANIFEST.in
# Включаемые и исключаемые файлы для пакета kostylpy

# ═══════════════════════════════════════════════════════════
# ИСХОДНЫЙ КОД
# ═══════════════════════════════════════════════════════════
include *.py
include *.txt
include *.md
include *.toml
include *.cfg
include *.ini
include *.json
include *.yaml
include *.yml
include LICENSE
include MANIFEST.in

recursive-include kostylpy *.py

# ═══════════════════════════════════════════════════════════
# ТЕСТЫ
# ═══════════════════════════════════════════════════════════
recursive-include tests *.py

# ═══════════════════════════════════════════════════════════
# ПРИМЕРЫ
# ═══════════════════════════════════════════════════════════
recursive-include examples *.py
recursive-include examples *.json

# ═══════════════════════════════════════════════════════════
# ДОКУМЕНТАЦИЯ
# ═══════════════════════════════════════════════════════════
recursive-include docs *.md
recursive-include docs *.rst
recursive-include docs *.txt

# ═══════════════════════════════════════════════════════════
# ИСКЛЮЧЕНИЯ
# ═══════════════════════════════════════════════════════════
# Временные файлы
global-exclude *.pyc
global-exclude *.pyo
global-exclude *.pyd
global-exclude __pycache__
global-exclude *.so
global-exclude *.dll
global-exclude *.dylib

# Файлы разработки
global-exclude .git
global-exclude .gitignore
global-exclude .gitattributes
global-exclude .DS_Store
global-exclude Thumbs.db

# Директории
prune .git
prune __pycache__
prune *.egg-info
prune build
prune dist
prune .pytest_cache
prune .coverage
prune htmlcov
prune .tox
prune .mypy_cache
prune .idea
prune .vscode

# Логи
global-exclude *.log
global-exclude coffee_breaks.log
global-exclude production.log

# Базы данных (заглушки)
global-exclude kostyl_db.json